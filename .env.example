PORT=3001
NODE_ENV=test
JWT_SECRET=your_jwt_secret
# postgres connection (local/prod) - usado por .env e .env.development
DATABASE_URL=postgresql://smart_order:smart_order@localhost:5432/db-smart
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
