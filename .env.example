POSTGRES_TEST_PORT=5433
POSTGRES_TEST_DB=db-smart-test
POSTGRES_TEST_USER=smart_order
POSTGRES_TEST_PASSWORD=smart_order

MONGO_URI=mongodb://localhost:27017/dbuserapi
